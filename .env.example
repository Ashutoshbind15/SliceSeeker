# Docker Compose — tusd hook target (dev)
#
# Dev (pnpm infra:dev): tusd uses host networking and calls localhost services.
# Run the API with: pnpm --filter server dev
TUSD_HOOKS_URL=http://127.0.0.1:3000/api/tusd-hooks
#
# Prod (docker compose --profile prod up): tusd calls the internal server service.
# TUSD_HOOKS_URL=http://server:3000/api/tusd-hooks
