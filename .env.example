# Local docker-compose.dev.yml only — not read by production image builds.
TUSD_PORT=8080
TUSD_HOOKS_URL=http://127.0.0.1:3000/api/tusd-hooks
# Allow any localhost UI port so worktrees can share tusd :8080. Omit to
# allow only http://localhost:5173 (compose default).
TUSD_CORS_ALLOW_ORIGIN=^http://(localhost|127[.]0[.]0[.]1):[0-9]+$
