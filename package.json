{
  "name": "sliceseeker",
  "version": "0.1.2",
  "description": "Self-hostable internal semantic video search",
  "main": "index.js",
  "scripts": {
    "infra": "docker compose -f docker-compose.dev.yml up -d db valkey rustfs tusd",
    "build:packages": "pnpm --filter db --filter queue --filter search-client run build",
    "dev:all": "pnpm build:packages && pnpm infra && pnpm --filter client --filter search --filter server --filter worker --parallel run dev",
    "worker:dev": "pnpm --filter worker dev",
    "worktree:isolate": "bash scripts/worktree/isolate.sh",
    "worktree:teardown": "bash scripts/worktree/teardown.sh",
    "db:push": "pnpm --filter db db:push",
    "db:studio": "pnpm --filter db db:studio",
    "licenses:check": "node scripts/check-allowed-licenses.mjs",
    "licenses:notices": "node scripts/generate-third-party-notices.mjs",
    "licenses:caddy:self-test": "sh scripts/collect-caddy-go-licenses.sh --self-test",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0"
}
