# Local Vite only. The production image uses Caddy paths
# (/endpoints/api, /files/). isolate.sh rewrites these in worktrees.
VITE_DEV_PORT=5173
VITE_API_URL=http://localhost:3000
VITE_TUSD_ENDPOINT=http://localhost:8080/files/
# Worktrees only. When true, uploads ask the shared tusd hook to forward
# to this checkout's indexer-api. Leave unset on the primary checkout.
# VITE_TUSD_HOOK_FORWARD=true
