VALKEY_URL=redis://127.0.0.1:6379
# Worktrees append a logical DB index, e.g. redis://127.0.0.1:6379/3
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/demo_search
DB_POOL_MAX=10

EMBEDDING_MODEL=google/gemini-embedding-2
TRANSCRIPTION_MODEL=openai/whisper-1
AI_GATEWAY_API_KEY=

# Object storage (S3-compatible)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# Prep (ffmpeg/S3) vs API (embed/ASR) workers — separate queues
PREP_WORKER_CONCURRENCY=4
API_WORKER_CONCURRENCY=2
# Cap concurrent BullMQ adds + DB writes when fan-out enqueueing many jobs for one file
ENQUEUE_CONCURRENCY=16
# Retries: exponential backoff; permanent fail after max attempts or max age
PREP_JOB_ATTEMPTS=5
PREP_JOB_BACKOFF_MS=3000
PREP_JOB_MAX_AGE_MS=1800000
API_JOB_ATTEMPTS=3
API_JOB_BACKOFF_MS=1000
API_JOB_MAX_AGE_MS=1800000
# frame image embeds: frames per Bull job, and parallel embeds within a batch
EMBED_FRAME_BATCH_SIZE=8
EMBED_FRAME_CONCURRENCY=2
