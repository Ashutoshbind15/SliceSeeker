PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/demo_search
# Optional. Defaults to http://localhost:5173 and http://127.0.0.1:5173
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Local worktrees only. When true, this process may forward tusd hooks to
# another loopback indexer from upload metadata (hookTarget). Default off;
# never set this in production / image env.
# TUSD_HOOK_FORWARD_LOCAL=true
DB_POOL_MAX=10
VALKEY_URL=redis://127.0.0.1:6379
# Worktrees append a logical DB index, e.g. redis://127.0.0.1:6379/3

EMBEDDING_MODEL=google/gemini-embedding-2
TRANSCRIPTION_MODEL=openai/whisper-1
AI_GATEWAY_API_KEY=

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin

# Cap concurrent BullMQ adds + DB writes when fan-out enqueueing jobs for one file
ENQUEUE_CONCURRENCY=16
