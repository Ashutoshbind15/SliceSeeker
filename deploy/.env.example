# Production deployment environment for deploy/docker-compose.*.yml
# Copy to deploy/.env and adjust for your environment.
#
# DATABASE_URL and S3_BUCKET must refer to the same dataset
# that Phase 1 wrote. Back up Postgres and object storage together.
#
# Schema: `db-push` (drizzle-kit push) runs once per compose up against Postgres.
# Phase 1/2 `/ready` checks required tables exist; it does not mutate schema.

COMPOSE_PROJECT_NAME=demo-search-ai

# --- Postgres (shared by Phase 1 and Phase 2) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=demo_search
POSTGRES_PUBLISH_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/demo_search

# --- Valkey (Phase 1 only; omit on Phase 2-only hosts) ---
VALKEY_URL=redis://valkey:6379
VALKEY_PUBLISH_PORT=6379

# --- S3-compatible object storage (Phase 1 only) ---
# S3_ENDPOINT: internal Docker hostname for indexer-api, worker, and tusd.
# S3_PUBLIC_ENDPOINT: browser-reachable host for presigned playback URLs (search previews).
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_S3_PUBLISH_PORT=9000
RUSTFS_CONSOLE_PUBLISH_PORT=9001

# --- Embeddings (Phase 1 write path + Phase 2 query embedding) ---
EMBEDDING_MODEL=google/gemini-embedding-2
AI_GATEWAY_API_KEY=

# --- Published ports (host → container) ---
INDEXER_API_PUBLISH_PORT=3000
ADMIN_UI_PUBLISH_PORT=8080
TUSD_PUBLISH_PORT=8081
SEARCH_API_PUBLISH_PORT=3001

# --- Worker tuning (Phase 1) ---
WORKER_CONCURRENCY=2
