# Bundled stack — copy to .env and adjust ports or secrets as needed.
# All backing services run as containers on the same Compose network.
#
# Schema: db-push runs once per `docker compose up` against Postgres.
# Phase /ready endpoints verify tables exist; they do not migrate schema.

COMPOSE_PROJECT_NAME=demo-search-ai

# --- Postgres (bundled service: db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=demo_search
POSTGRES_PUBLISH_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/demo_search

# --- Valkey (bundled service: valkey; Phase 1 only) ---
VALKEY_URL=redis://valkey:6379
VALKEY_PUBLISH_PORT=6379

# --- S3-compatible storage (bundled service: rustfs; Phase 1 only) ---
# S3_BUCKET is written into uploads.storage_bucket at ingest.
# S3_ENDPOINT: internal Compose hostname for indexer-api, worker, and tusd.
# S3_PUBLIC_ENDPOINT: host-reachable URL for presigned playback in the admin UI.
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=uploads
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
RUSTFS_S3_PUBLISH_PORT=9000
RUSTFS_CONSOLE_PUBLISH_PORT=9001

# --- Embeddings (Phase 1 write path + Phase 2 query embedding) ---
EMBEDDING_MODEL=google/gemini-embedding-2
AI_GATEWAY_API_KEY=

# --- Admin UI upstreams (Compose service names) ---
API_UPSTREAM=indexer-api:3000
TUSD_UPSTREAM=tusd:8080
TUSD_HOOKS_URL=http://indexer-api:3000/api/tusd-hooks

# --- Published ports (host → container) ---
INDEXER_API_PUBLISH_PORT=3000
ADMIN_UI_PUBLISH_PORT=8080
TUSD_PUBLISH_PORT=8081
SEARCH_API_PUBLISH_PORT=3001

# --- Worker tuning (Phase 1) ---
# Prep (ffmpeg/S3) and API (embed/ASR) run on separate queues
PREP_WORKER_CONCURRENCY=4
API_WORKER_CONCURRENCY=2
PREP_JOB_ATTEMPTS=5
PREP_JOB_BACKOFF_MS=3000
PREP_JOB_MAX_AGE_MS=1800000
API_JOB_ATTEMPTS=3
API_JOB_BACKOFF_MS=1000
API_JOB_MAX_AGE_MS=1800000
