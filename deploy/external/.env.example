# External services — copy to .env and set URLs for your existing infrastructure.
# Application containers connect via these variables; no database, queue, or
# object storage containers are started by this layout.
#
# Run docker-compose.init.yml once before first start and after schema upgrades.

COMPOSE_PROJECT_NAME=demo-search-ai

# --- Postgres (your managed or self-hosted instance) ---
# Example: a Postgres host reachable from containers.
DATABASE_URL=postgresql://USER:PASSWORD@postgres.example.com:5432/demo_search
# Max connections per API/worker/search process (default 10).
# Keep replicas × DB_POOL_MAX under Postgres max_connections (tight on managed plans).
DB_POOL_MAX=10

# --- Valkey / Redis (Phase 1 only) ---
# BullMQ requires maxmemory-policy noeviction (bundled Valkey sets this; managed
# Redis often defaults to LRU, which can silently drop queue keys).
# Self-hosted: redis://host:6379  (e.g. valkey-server --maxmemory-policy noeviction)
# Managed (TLS + auth): rediss://user:TOKEN@queue.example.com:6379
VALKEY_URL=redis://redis.example.com:6379
# Set true only when your provider blocks CONFIG GET but you confirmed noeviction
# in the provider dashboard. Phase 1 /ready still fails if policy
# is readable and not noeviction.
# VALKEY_SKIP_EVICTION_CHECK=true

# --- S3-compatible object storage (Phase 1 only) ---
# S3_BUCKET is written into uploads.storage_bucket at ingest; create the bucket yourself.
# S3_ENDPOINT: API endpoint reachable from application containers.
# S3_PUBLIC_ENDPOINT: browser-reachable URL used in presigned playback links.
#
# Regional endpoint example:
#   S3_ENDPOINT=https://storage.example.com
#   S3_PUBLIC_ENDPOINT=https://storage.example.com
# Self-hosted example:
#   S3_ENDPOINT=https://object-storage.example.com
#   S3_PUBLIC_ENDPOINT=https://object-storage.example.com
S3_ENDPOINT=https://storage.example.com
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Embeddings (Phase 1 write path + Phase 2 query embedding) ---
EMBEDDING_MODEL=google/gemini-embedding-2
AI_GATEWAY_API_KEY=

# --- Admin UI and upload wiring (Phase 1) ---
# host:port targets for Caddy reverse_proxy inside admin-ui.
# Defaults assume indexer-api and tusd run in the same Compose project.
API_UPSTREAM=indexer-api:3000
TUSD_UPSTREAM=tusd:8080
# Full URL tusd calls when an upload finishes (must reach indexer-api).
TUSD_HOOKS_URL=http://indexer-api:3000/api/tusd-hooks

# --- Published ports (host → container) ---
INDEXER_API_PUBLISH_PORT=3000
ADMIN_UI_PUBLISH_PORT=8080
TUSD_PUBLISH_PORT=8081
SEARCH_API_PUBLISH_PORT=3001

# --- Worker tuning (Phase 1) ---
PREP_WORKER_CONCURRENCY=4
API_WORKER_CONCURRENCY=2
# Cap concurrent BullMQ adds + DB writes on per-file job fan-out
ENQUEUE_CONCURRENCY=16
PREP_JOB_ATTEMPTS=5
PREP_JOB_BACKOFF_MS=3000
PREP_JOB_MAX_AGE_MS=1800000
API_JOB_ATTEMPTS=3
API_JOB_BACKOFF_MS=1000
API_JOB_MAX_AGE_MS=1800000
