{
  "name": "db",
  "version": "1.0.0",
  "description": "Shared database schema and access layer",
  "type": "module",
  "exports": {
    ".": "./dist/client.js",
    "./access/*.js": "./dist/access/*.js",
    "./schema/*.js": "./dist/schema/*.js",
    "./readiness.js": "./dist/readiness.js",
    "./constants.js": "./dist/constants.js"
  },
  "scripts": {
    "build": "tsc",
    "db:push": "node scripts/bootstrap-extension.mjs && drizzle-kit push --force",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3"
  }
}
